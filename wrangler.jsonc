// Cloudflare Workers config: serves the built site in public/ as static assets.
// Build command: npm run build · Deploy command: npx wrangler deploy
{
  "name": "aydinkalantar-com",
  "compatibility_date": "2026-10-01",
  // Gives every pull request its own preview link
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    // Unknown addresses get the friendly 404 page (public/404.html) with links back into the site
    "not_found_handling": "404-page"
  }
}
